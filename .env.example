# Optional: replace this with a self-hosted or third-party
# Nominatim-compatible endpoint for global location search.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional: use Tracestrack's hosted Overpass API for OpenStreetMap geometry.
# Create a key at Tracestrack, then set only the key here.
# TRACESTRACK_API_KEY=your_tracestrack_api_key

# Optional: point OpenStreetMap geometry fetches at one or more full
# Overpass-compatible interpreter URLs. Separate multiple endpoints with commas.
# These are tried after Tracestrack and before the built-in public mirrors.
# OVERPASS_INTERPRETER_URLS=https://example.com/api/interpreter

# Optional: pin a specific Overture buildings PMTiles archive.
# By default, Forge Map 3D discovers the newest public Overture release.
# OVERTURE_BUILDINGS_PM_TILES_URL=https://example.com/buildings.pmtiles

# Optional: override the default production Umami website id.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Optional: replace this when using a self-hosted Umami instance.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
